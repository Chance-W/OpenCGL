<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="homeRootPane" stylesheets="@../css/HomePane.css" prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/10.0.2-internal"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.opencgl.controller.HomePaneController">
    <top>
        <HBox alignment="CENTER_RIGHT" nodeOrientation="LEFT_TO_RIGHT" BorderPane.alignment="CENTER">
            <Label fx:id="timeLabel" style="-fx-font-size: 20"/>
            <BorderPane.margin>
                <Insets right="20.0" top="10.0"/>
            </BorderPane.margin>
        </HBox>
    </top>
    <center>
        <VBox StackPane.alignment="TOP_CENTER" spacing="30">
            <HBox spacing="40" style="-fx-padding: 0 0 0 50;">
                <MFXButton buttonType="RAISED" onAction="#jumpHomePage" prefHeight="30" prefWidth="100"
                           text="个人主页"/>
            </HBox>
            <HBox spacing="40" style="-fx-padding: 0 0 0 50;">
                <GridPane alignment="CENTER" hgap="20.0" styleClass="grid-pane">
                    <padding>
                        <Insets bottom="20.0" right="30.0" top="20.0"/>
                    </padding>
                    <StackPane HBox.hgrow="ALWAYS" minHeight="150.0" minWidth="300.0" styleClass="grid-background"
                               GridPane.columnSpan="10"
                               GridPane.rowSpan="2">
                        <GridPane.margin>
                            <Insets left="-15.0" top="-15.0" right="-15.0"/>
                        </GridPane.margin>
                        <opaqueInsets>
                            <Insets/>
                        </opaqueInsets>
                    </StackPane>
                    <Label alignment="TOP_LEFT" styleClass="header-label" text="OpenCGL管理工具"/>
                    <TextArea fx:id="softwareIntroduce" GridPane.rowIndex="1" prefWidth="10000" GridPane.columnSpan="10"
                              wrapText="true" editable="false" HBox.hgrow="ALWAYS"/>
                </GridPane>
            </HBox>
            <HBox spacing="40" style="-fx-padding: 0 0 0 50;">
                <GridPane alignment="CENTER" hgap="20.0" styleClass="grid-pane">
                    <padding>
                        <Insets bottom="20.0" right="30.0" top="20.0"/>
                    </padding>
                    <StackPane HBox.hgrow="ALWAYS" minHeight="150.0" minWidth="200.0" styleClass="grid-background"
                               GridPane.columnSpan="10"
                               GridPane.rowSpan="3">
                        <GridPane.margin>
                            <Insets left="-15.0" top="-15.0" right="-15.0"/>
                        </GridPane.margin>
                        <opaqueInsets>
                            <Insets/>
                        </opaqueInsets>
                    </StackPane>
                    <Label alignment="TOP_LEFT" styleClass="header-label" text="技术框架"/>
                    <TextArea fx:id="softwareFrameworkIntroduce" wrapText="true" editable="false" GridPane.rowIndex="2"
                              HBox.hgrow="ALWAYS"/>
                </GridPane>
                <GridPane alignment="CENTER" hgap="20.0" styleClass="grid-pane">
                    <padding>
                        <Insets bottom="20.0" right="30.0" top="20.0"/>
                    </padding>
                    <StackPane HBox.hgrow="ALWAYS" minHeight="150.0" minWidth="200.0" styleClass="grid-background"
                               GridPane.columnSpan="5"
                               GridPane.rowSpan="4">
                        <GridPane.margin>
                            <Insets left="-15.0" top="-15.0" right="-15.0"/>
                        </GridPane.margin>
                        <opaqueInsets>
                            <Insets/>
                        </opaqueInsets>
                    </StackPane>
                    <Label alignment="TOP_LEFT" styleClass="header-label" text="工具说明"/>
                    <TextArea fx:id="softwareSuggestion" wrapText="true" editable="false" GridPane.rowIndex="3"
                              GridPane.columnSpan="5" HBox.hgrow="ALWAYS"/>
                </GridPane>
            </HBox>
        </VBox>
    </center>
</BorderPane>
