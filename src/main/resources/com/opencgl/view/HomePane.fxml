<?xml version="1.0" encoding="UTF-8"?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="homeRootPane" styleClass="home-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.opencgl.controller.HomePaneController">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="home-scroll">
            <content>
                <VBox spacing="16.0" styleClass="home-dashboard">
                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="20.0"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="home-hero">
                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="welcomeLabel" styleClass="home-eyebrow" text="WELCOME"/>
                            <Label fx:id="mainTitleLabel" styleClass="home-title" text="OpenCGL"/>
                            <Label fx:id="softwareIntroduce" maxWidth="760.0" styleClass="home-description" text="OpenCGL" wrapText="true"/>
                            <Label fx:id="versionLabel" styleClass="home-version" text="v0.0.0"/>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Label fx:id="timeLabel" styleClass="home-time"/>
                            <MFXButton fx:id="jumpHomeBtn" buttonType="RAISED" onAction="#jumpHomePage"
                                       styleClass="home-primary-button" text="访问项目主页"/>
                        </VBox>
                    </HBox>
                    <GridPane hgap="16.0" vgap="16.0" styleClass="home-card-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <VBox GridPane.columnIndex="0" spacing="14.0" styleClass="home-card" GridPane.hgrow="ALWAYS">
                            <Label fx:id="frameworkTitleLabel" styleClass="home-card-title" text="技术架构"/>
                            <Label fx:id="frameworkDescriptionLabel" styleClass="home-card-subtitle"
                                   text="构建桌面端插件生态的核心技术" wrapText="true"/>
                            <FlowPane hgap="8.0" vgap="8.0">
                                <Label styleClass="home-tech-chip" text="Zulu JDK 21"/>
                                <Label styleClass="home-tech-chip" text="JavaFX"/>
                                <Label styleClass="home-tech-chip" text="MaterialFX"/>
                                <Label styleClass="home-tech-chip" text="FontAwesome"/>
                                <Label styleClass="home-tech-chip" text="Plugin SPI"/>
                            </FlowPane>
                            <Region VBox.vgrow="ALWAYS"/>
                        </VBox>
                        <VBox GridPane.columnIndex="1" spacing="12.0" styleClass="home-card" GridPane.hgrow="ALWAYS">
                            <Label fx:id="guideTitleLabel" styleClass="home-card-title" text="使用指引"/>
                            <Label fx:id="guideFirstLabel" styleClass="home-guide-row" text="01  从左侧分类选择需要的工具" wrapText="true"/>
                            <Label fx:id="guideSecondLabel" styleClass="home-guide-row" text="02  在应用市场发现并安装插件" wrapText="true"/>
                            <Label fx:id="guideThirdLabel" styleClass="home-guide-row" text="03  在设置中管理插件与主题" wrapText="true"/>
                        </VBox>
                    </GridPane>
                    <VBox spacing="13.0" styleClass="home-card">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label fx:id="suggestionTitleLabel" styleClass="home-card-title" text="项目与联系"/>
                                <Label fx:id="contactDescriptionLabel" styleClass="home-card-subtitle"
                                       text="欢迎交流工具和插件建议" wrapText="true"/>
                            </VBox>
                        </HBox>
                        <FlowPane hgap="24.0" vgap="10.0">
                            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="home-contact-row">
                                <Label styleClass="home-contact-key" text="Email"/>
                                <Label text="chance.w@qq.com · chance_w@126.com"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="home-contact-row">
                                <Label fx:id="wechatKeyLabel" styleClass="home-contact-key" text="微信"/>
                                <Label text="Chance_W-"/>
                            </HBox>
                        </FlowPane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
